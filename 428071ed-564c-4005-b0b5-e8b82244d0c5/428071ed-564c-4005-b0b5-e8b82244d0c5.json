                  "Value": "using System;\nusing System.Collections;\nusing System.Xml;\n\npublic class MyClass : BaseCode {\n\t// This method is called each time the building block is run.\n\tpublic override void Run() {\n\n\t\tLogMessage(\"C# code is running...\");\t\n\t\t\n\t\tXmlDocument xd = new XmlDocument();\t\t\n        xd.LoadXml(Fields[\"FilePath\"].ToString());\n\t\tXmlNodeList nodelist = xd.SelectNodes(\"/Product\");\n\t\tforeach (XmlNode node in nodelist) \n  \t\t{    \t\n      \n\t\t  foreach (XmlElement nodeItem in node) {\n\t\t   \n\t\t     LogMessage(nodeItem.InnerText.ToString());\n\t\t  }\n\t\t}\t\n\t\t\n\t}\n}\n",
